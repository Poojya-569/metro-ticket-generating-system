        <script><![CDATA[(function executeRule(current, previous) {

    if (!current.metro_status.changesTo('cancelled')) {
        return;
    }

    var fare =
        parseFloat(current.getValue('total_fare')) || 0;

    var travelDate =
        current.getValue('travel_date');

    var today =
        new GlideDate().getValue();

    var refund = 0;

    if (travelDate > today) {

        refund = fare * 0.90;

    } else if (travelDate == today) {

        refund = fare * 0.50;

    } else {

        refund = 0;
    }

    refund =
        Math.round(refund * 100) / 100;

    current.setValue(
        'refund_amount',
        refund
    );

})(current, previous);]]></script>
