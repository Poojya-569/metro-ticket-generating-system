        <script><![CDATA[(function() {

    var today = new GlideDate().getValue();

    var booking =
        new GlideRecord(
            'x_1958892_metro_0_metro_booking'
        );

    booking.addQuery(
        'metro_status',
        'pending'
    );

    booking.addQuery(
        'travel_date',
        '<',
        today
    );

    booking.query();

    while (booking.next()) {

        booking.setValue(
            'metro_status',
            'cancelled'
        );

        booking.setValue(
            'cancellation_reason',
            'Automatically cancelled because travel date expired.'
        );

        booking.update();
    }

})();]]></script>
